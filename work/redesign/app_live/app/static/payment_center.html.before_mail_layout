<script>
/* V7.24 Central mail config bridge */
let RENEW_MAIL_CONFIG={templates:[],custom_vars:[],authorities:[]};
async function loadCentralMailConfig(){
 try{
  const r=await fetch('/api/mail-config',{credentials:'same-origin'});if(!r.ok)return;
  RENEW_MAIL_CONFIG=await r.json();populatePaymentTemplates();populateDevirAuthorities();
  mailMetniGuncelle();odemeMetniGuncelle();sigortaMetniGuncelle();devirMetniGuncelle();
 }catch(e){}
}
function moduleTemplates(module){return (RENEW_MAIL_CONFIG.templates||[]).filter(x=>x.module===module&&x.active!==false)}
function fillTplSelect(id,module){
 const s=document.getElementById(id);if(!s)return;const old=s.value,arr=moduleTemplates(module);
 s.innerHTML=arr.map(x=>'<option value="'+x.id+'">'+(x.name||x.type||'Şablon')+'</option>').join('');
 if(old&&arr.some(x=>x.id===old))s.value=old
}
function populatePaymentTemplates(){fillTplSelect('mailTemplateSelect','tahsilat');fillTplSelect('odemeTemplateSelect','odeme');fillTplSelect('sigortaTemplateSelect','sigorta');fillTplSelect('devirTemplateSelect','devir')}
function selectedTpl(module){
 const ids={tahsilat:'mailTemplateSelect',odeme:'odemeTemplateSelect',sigorta:'sigortaTemplateSelect',devir:'devirTemplateSelect'};
 const id=document.getElementById(ids[module])?.value;return moduleTemplates(module).find(x=>x.id===id)||moduleTemplates(module)[0]||null
}
function tplApply(text,v){return String(text||'').replace(/\{([a-zA-Z0-9_ğüşöçıİĞÜŞÖÇ]+)\}/g,(m,k)=>v[k]??m)}
function currentAuthority(){
 const s=document.getElementById('devirYetkili'),id=s?.value;return (RENEW_MAIL_CONFIG.authorities||[]).find(x=>x.id===id)||(RENEW_MAIL_CONFIG.authorities||[])[0]||{}
}
function populateDevirAuthorities(){
 const s=document.getElementById('devirYetkili');if(!s)return;const old=s.value,arr=RENEW_MAIL_CONFIG.authorities||[];
 s.innerHTML=arr.map(a=>'<option value="'+a.id+'">'+(a.name||'Yetkili')+(a.title?' — '+a.title:'')+'</option>').join('');
 if(old&&arr.some(a=>a.id===old))s.value=old
}
const _oldMail=mailMetniOlustur,_oldOdeme=odemeMetniOlustur,_oldSigorta=sigortaMetniOlustur,_oldDevir=devirMetniOlustur;
mailMetniOlustur=function(){
 const t=selectedTpl('tahsilat');if(!t)return _oldMail();
 const alici=document.getElementById('mailAlici').value.trim()||'[ALICI ADI SOYADI]',tc=document.getElementById('mailTc').value.trim()||'[TC KİMLİK NO]',cep=document.getElementById('mailCep').value.trim()||'[CEP NO]',h=document.getElementById('mailTutar').value.trim()||'[TUTAR]',tutar=h==='[TUTAR]'?h:h+' TL';
 return tplApply(t.body,{alici,tc,cep,tutar,kart_tipi:seciliKartTipi})
};
odemeMetniOlustur=function(){
 const t=selectedTpl('odeme');if(!t)return _oldOdeme();
 const isim=document.getElementById('odemeIsim').value.trim()||'[İSİM SOYİSİM]',h=document.getElementById('odemeTutar').value.trim()||'[TUTAR]',tutar=h==='[TUTAR]'?h:h+' TL',banka=document.getElementById('odemeBanka').value||'[BANKA]';
 return tplApply(t.body,{isim,tutar,banka})
};
sigortaMetniOlustur=function(){
 const t=selectedTpl('sigorta');if(!t)return _oldSigorta();const plaka=document.getElementById('sigortaPlaka').value.trim()||'[PLAKA]';return tplApply(t.body,{plaka})
};
devirMetniOlustur=function(){
 const t=selectedTpl('devir');if(!t)return _oldDevir();const h=document.getElementById('devirTutar').value.trim(),k=document.getElementById('devirKm').value.trim(),a=currentAuthority(),tutar=h?h+' TL':'[ARAÇ BEDELİ]',km=k?k+' KM':'[KM]',plaka_durumu=devirPlakaDurumu==='degisecek'?'Plaka değişecektir.':'Plaka aynı kalacaktır.';
 return tplApply(t.body,{yetkili:a.name||'[YETKİLİ]',yetkili_unvan:a.title||'',yetkili_tel:a.phone||'',tutar,km,plaka_durumu})
};
function openTplOutlook(module,body){
 const t=selectedTpl(module);if(!t)return;
 const vars={};
 if(module==='tahsilat'){const h=document.getElementById('mailTutar').value.trim();Object.assign(vars,{alici:document.getElementById('mailAlici').value.trim(),tc:document.getElementById('mailTc').value.trim(),cep:document.getElementById('mailCep').value.trim(),tutar:h?h+' TL':'',kart_tipi:seciliKartTipi})}
 if(module==='odeme'){const h=document.getElementById('odemeTutar').value.trim();Object.assign(vars,{isim:document.getElementById('odemeIsim').value.trim(),tutar:h?h+' TL':'',banka:document.getElementById('odemeBanka').value})}
 if(module==='sigorta')Object.assign(vars,{plaka:document.getElementById('sigortaPlaka').value.trim()});
 if(module==='devir'){const a=currentAuthority(),h=document.getElementById('devirTutar').value.trim(),k=document.getElementById('devirKm').value.trim();Object.assign(vars,{yetkili:a.name||'',yetkili_unvan:a.title||'',yetkili_tel:a.phone||'',tutar:h?h+' TL':'',km:k?k+' KM':'',plaka_durumu:devirPlakaDurumu==='degisecek'?'Plaka değişecektir.':'Plaka aynı kalacaktır.'})}
 const url='https://outlook.office.com/mail/deeplink/compose?to='+encodeURIComponent(t.to||'')+'&cc='+encodeURIComponent(t.cc||'')+'&subject='+encodeURIComponent(tplApply(t.subject,vars))+'&body='+encodeURIComponent(body);window.open(url,'_blank','noopener,noreferrer')
}
outlooktaHazirla=function(){openTplOutlook('tahsilat',mailMetniOlustur())};
odemeOutlooktaHazirla=function(){openTplOutlook('odeme',odemeMetniOlustur())};
sigortaOutlooktaHazirla=function(){openTplOutlook('sigorta',sigortaMetniOlustur())};
devirOutlooktaHazirla=function(){openTplOutlook('devir',devirMetniOlustur())};
window.addEventListener('message',e=>{if(e.origin===location.origin&&e.data?.type==='renew-mail-config-updated')loadCentralMailConfig()});
document.addEventListener('visibilitychange',()=>{if(!document.hidden)loadCentralMailConfig()});
document.addEventListener('DOMContentLoaded',loadCentralMailConfig);
setTimeout(loadCentralMailConfig,250);
</script>

