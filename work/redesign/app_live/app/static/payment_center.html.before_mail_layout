 function syncDevirAuthority(){
   const s=document.getElementById('devirYetkili');if(!s)return;
   const arr=authorities();if(!arr.length)return;
   const old=s.value;s.innerHTML=arr.map(a=>'<option value="'+String(a.name||'').replace(/"/g,'&quot;')+'">'+(a.name||'Yetkili')+(a.title?' — '+a.title:'')+'</option>').join('');
   if([...s.options].some(o=>o.value===old))s.value=old;
