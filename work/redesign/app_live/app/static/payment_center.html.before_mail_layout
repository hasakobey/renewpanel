<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RENEW PRO • Ödeme Merkezi</title>
    <!-- Sekme İkonu (Favicon) -->
    <link rel="icon" type="image/x-icon" href="renew.ico">
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #090d16 0%, #172033 100%);
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --input-bg: #f8fafc;
            --result-bg: #f8fafc;
            --primary: #000000;
            --primary-hover: #333333;
        }

        [data-theme="dark"] {
            --bg-gradient: linear-gradient(135deg, #020617 0%, #0f172a 100%);
            --card-bg: #111827;
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --border-color: #374151;
            --input-bg: #1f2937;
            --result-bg: #1f2937;
            --primary: #ffffff;
            --primary-hover: #e5e7eb;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; transition: background 0.3s, color 0.3s, border-color 0.3s; }
        body { background: var(--bg-gradient); display: flex; justify-content: center; align-items: center; min-height: 100vh; color: var(--text-main); padding: 20px; }
        
        .wrapper { display: flex; gap: 20px; width: 100%; max-width: 1280px; align-items: flex-start; justify-content: center; }

        .side-panel { width: 320px; background: var(--card-bg); padding: 20px; border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); border-top: 4px solid var(--text-main); }
        .side-panel h3 { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; font-weight: 700; text-align: center; }

        .card { background: var(--card-bg); padding: 30px; border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35); width: 100%; max-width: 580px; border-top: 4px solid var(--text-main); position: relative; }
        
        .top-actions { position: absolute; top: 20px; right: 20px; display: flex; gap: 8px; }
        .icon-btn { background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-main); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; }
        
        .logo-header { text-align: center; margin-bottom: 20px; padding-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-right: 80px; }
        .logo-header img { height: 38px; object-fit: contain; }

        .brand { text-align: center; margin-bottom: 20px; }
        .brand h1 { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2.5px; font-weight: 700; }
        .brand h2 { font-size: 1.3rem; color: var(--text-main); margin-top: 4px; font-weight: 800; }
        
        .form-group { margin-bottom: 16px; }
        
        .toggle-section { margin-bottom: 16px; background: var(--input-bg); padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; cursor: pointer; }
        .toggle-section span { font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; }
        .toggle-switch { font-size: 1rem; font-weight: bold; color: var(--text-main); }
        
        .collapsible-content { display: none; margin-bottom: 16px; animation: fadeIn 0.3s ease-in-out; }
        .collapsible-content.show { display: block; }

        label { display: block; margin-bottom: 6px; font-weight: 700; color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; }
        input, select { width: 100%; padding: 12px; border: 1.5px solid var(--border-color); border-radius: 8px; font-size: 0.95rem; outline: none; background: var(--input-bg); font-weight: 600; color: var(--text-main); }
        input:focus, select:focus { border-color: var(--text-main); box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.15); }
        
        .quick-taksit { display: flex; gap: 6px; margin-bottom: 14px; }
        .taksit-btn { flex: 1; padding: 8px; border: 1.5px solid var(--border-color); background: var(--input-bg); border-radius: 8px; font-weight: 700; cursor: pointer; color: var(--text-muted); font-size: 0.8rem; }
        .taksit-btn:hover { border-color: var(--text-main); color: var(--text-main); }
        .taksit-btn.active { background: var(--text-main); color: var(--card-bg); border-color: var(--text-main); }

        .result-box { margin-top: 20px; background: var(--result-bg); border-radius: 10px; border: 1px solid var(--border-color); display: none; overflow: hidden; animation: fadeIn 0.4s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

        .result-item { display: flex; justify-content: space-between; padding: 10px 14px; font-size: 0.85rem; border-bottom: 1px solid var(--border-color); }
        .result-item:last-child { border-bottom: none; font-weight: bold; background: var(--text-main); color: var(--card-bg); font-size: 0.95rem; padding: 12px 14px; }
        .result-item span { color: var(--text-muted); font-weight: 600; }
        .result-item strong { color: var(--text-main); }
        .result-item:last-child span, .result-item:last-child strong { color: var(--card-bg); }

        .btn-container { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }
        .action-btn { flex: 1; padding: 12px; border-radius: 8px; font-weight: 700; font-size: 0.9rem; cursor: pointer; border: 1.5px solid var(--border-color); text-align: center; display: flex; align-items: center; justify-content: center; gap: 6px; }
        
        .copy-btn { background-color: var(--input-bg); color: var(--text-main); display: none; }
        .copy-btn:hover { background-color: var(--border-color); }

        .pdf-btn { background-color: var(--text-main); color: var(--card-bg); border-color: var(--text-main); display: none; }
        .pdf-btn:hover { opacity: 0.9; }

        .bank-card { background: var(--input-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
        .bank-info { flex: 1; }
        .bank-name { font-size: 0.75rem; font-weight: 800; color: var(--text-main); margin-bottom: 3px; }
        .bank-iban { font-size: 0.75rem; font-family: monospace; font-weight: 700; color: var(--text-main); }
        
        .bank-copy-btn { background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 6px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
        .bank-copy-btn:hover { background: var(--text-main); color: var(--card-bg); }

        @media (max-width: 850px) {
            .wrapper { flex-direction: column-reverse; align-items: center; }
            .side-panel { width: 100%; max-width: 580px; }
        }

        /* PDF / yazdırma görünümü */
        .print-sheet { display:none; }
        .pdf-modal { display:none; position:fixed; inset:0; z-index:9999; background:rgba(2,6,23,.62); backdrop-filter:blur(5px); align-items:center; justify-content:center; padding:20px; }
        .pdf-modal.show { display:flex; }
        .pdf-modal-card { width:100%; max-width:430px; background:var(--card-bg); color:var(--text-main); border-radius:16px; box-shadow:0 30px 80px rgba(0,0,0,.35); overflow:hidden; border:1px solid var(--border-color); }
        .pdf-modal-head { padding:18px 20px; border-bottom:1px solid var(--border-color); }
        .pdf-modal-head strong { display:block; font-size:1rem; margin-bottom:4px; }
        .pdf-modal-head span { color:var(--text-muted); font-size:.8rem; }
        .pdf-modal-actions { padding:16px; display:grid; gap:10px; }
        .pdf-choice { width:100%; padding:13px 14px; border-radius:10px; border:1px solid var(--border-color); background:var(--input-bg); color:var(--text-main); font-weight:800; cursor:pointer; text-align:left; }
        .pdf-choice.primary { background:var(--text-main); color:var(--card-bg); border-color:var(--text-main); }
        .pdf-modal-close { width:100%; border:0; background:transparent; color:var(--text-muted); padding:4px 10px 16px; cursor:pointer; font-weight:700; }
        .bank-tools { display:flex; gap:8px; margin-top:12px; }
        .bank-tools button { flex:1; padding:9px 8px; border-radius:8px; border:1px solid var(--border-color); background:var(--input-bg); color:var(--text-main); font-size:.72rem; font-weight:800; cursor:pointer; }
        @media print {
            @page { size:A4; margin:12mm; }
            * { transition:none !important; }
            body { background:#fff !important; color:#111827 !important; padding:0 !important; display:block !important; min-height:auto !important; }
            .wrapper, .pdf-modal { display:none !important; }
            .print-sheet.active { display:block !important; }
            .print-doc { font-family:'Segoe UI',Arial,sans-serif; color:#111827; }
            .print-header { border:2px solid #111827; border-radius:12px; padding:18px 20px; margin-bottom:16px; display:flex; justify-content:space-between; align-items:flex-end; }
            .print-header h1 { font-size:18px; margin:0 0 4px; }
            .print-header .sub { font-size:11px; font-weight:700; letter-spacing:1px; color:#64748b; }
            .print-customer { background:#f8fafc; border:1px solid #dbe3ee; border-radius:10px; padding:12px 14px; margin-bottom:14px; }
            .print-customer b { font-size:13px; }
            .print-customer div { margin-top:4px; font-size:12px; color:#475569; }
            .print-table { width:100%; border-collapse:separate; border-spacing:0; border:1px solid #dbe3ee; border-radius:10px; overflow:hidden; }
            .print-table td { padding:11px 13px; border-bottom:1px solid #dbe3ee; font-size:12px; }
            .print-table tr:last-child td { border-bottom:0; }
            .print-table td:first-child { color:#52627a; font-weight:700; width:58%; }
            .print-table td:last-child { text-align:right; font-weight:800; }
            .print-table tr.total td { background:#0f172a; color:#fff; font-size:14px; font-weight:900; }
            .print-bank { border:1px solid #dbe3ee; border-radius:10px; padding:13px 14px; margin-bottom:10px; page-break-inside:avoid; }
            .print-bank-name { font-size:12px; font-weight:900; margin-bottom:6px; }
            .print-bank-iban { font-family:Consolas,monospace; font-size:13px; font-weight:800; }
            .print-footer { margin-top:16px; border-top:1px solid #dbe3ee; padding-top:10px; font-size:10px; color:#64748b; text-align:center; }
        }
    

        /* =========================================================
           2026 UI REFRESH — HESAPLAMA ALANI BİREBİR KORUNDU
           Aşağıdaki dokunuşlar yalnızca sayfa zemini, üst marka alanı,
           sol panel ve sonuç sonrası aksiyon butonlarını etkiler.
           Tutar / taksit / sonuç tablosu stillerine dokunulmamıştır.
           ========================================================= */
        body {
            background:
                radial-gradient(circle at 15% 18%, rgba(255,255,255,.08) 0, rgba(255,255,255,0) 28%),
                radial-gradient(circle at 88% 82%, rgba(255,214,0,.08) 0, rgba(255,214,0,0) 24%),
                linear-gradient(135deg, #07101f 0%, #101a2c 52%, #080d17 100%);
            position: relative;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background-image: linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
            background-size: 28px 28px;
            mask-image: linear-gradient(to bottom, rgba(0,0,0,.75), transparent 92%);
        }

        .wrapper {
            position: relative;
            z-index: 1;
        }

        /* Sol yardımcı panel — işlev aynı, görünüm daha premium */
        .side-panel {
            border-top: 0;
            box-shadow: 0 28px 70px -28px rgba(0,0,0,.72);
            position: relative;
            overflow: hidden;
        }

        .side-panel::before {
            content: "ÇAYAN OTOMOTİV  •  RENEW TARSUS";
            display: block;
            margin: -20px -20px 18px;
            padding: 12px 16px;
            background: #0f172a;
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-align: center;
        }

        [data-theme="dark"] .side-panel::before {
            background: #020617;
        }

        .side-panel .toggle-section {
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }

        .side-panel .toggle-section:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(15,23,42,.08);
        }

        .bank-card {
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .bank-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(15,23,42,.08);
        }

        /* Ana kartın yalnızca üst marka bölümü */
        .card {
            box-shadow: 0 30px 80px -32px rgba(0,0,0,.78);
        }

        .logo-header {
            position: relative;
        }

        .logo-header::after {
            content: "RENEW • GÜVENLİ ÖDEME";
            position: absolute;
            left: 50%;
            bottom: -9px;
            transform: translateX(-50%);
            background: var(--card-bg);
            color: var(--text-muted);
            padding: 0 10px;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.4px;
            white-space: nowrap;
        }

        .brand h1 {
            opacity: .92;
        }

        .brand h2 {
            letter-spacing: -.2px;
        }

        .icon-btn {
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .icon-btn:hover {
            transform: translateY(-1px) rotate(4deg);
            box-shadow: 0 8px 18px rgba(15,23,42,.12);
        }

        /* Sonuç alanının altındaki işlemler — hesaplama görünümünü etkilemez */
        .btn-container {
            padding-top: 2px;
        }

        .action-btn {
            min-height: 44px;
            transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease;
        }

        .action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(15,23,42,.12);
        }

        #wpBtn {
            font-size: .92rem !important;
            box-shadow: 0 10px 22px rgba(37,211,102,.14);
        }

        @media (max-width: 850px) {
            body { padding: 12px; }
            .side-panel::before { margin-left: -20px; margin-right: -20px; }
        }


        /* Mail hazırlama paneli */
        .mail-panel { width: 320px; background: var(--card-bg); padding: 20px; border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0,0,0,.35); position: relative; overflow: hidden; }
        .mail-panel::before { content: "MÜŞTERİ • HAZIR MAİL"; display:block; margin:-20px -20px 18px; padding:12px 16px; background:#0f172a; color:#fff; font-size:10px; font-weight:800; letter-spacing:1.5px; text-align:center; }
        [data-theme="dark"] .mail-panel::before { background:#020617; }
        .mail-panel h3 { font-size:.95rem; margin-bottom:14px; color:var(--text-main); }
        .mail-grid { display:grid; gap:12px; }
        .mail-choice { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
        .mail-choice button { padding:10px 8px; border:1.5px solid var(--border-color); background:var(--input-bg); color:var(--text-muted); border-radius:8px; font-weight:700; cursor:pointer; }
        .mail-choice button.active { background:var(--text-main); color:var(--card-bg); border-color:var(--text-main); }
        .mail-preview { width:100%; min-height:235px; resize:vertical; padding:12px; border:1.5px solid var(--border-color); border-radius:10px; background:var(--input-bg); color:var(--text-main); font:600 .78rem/1.55 'Segoe UI',Tahoma,Geneva,Verdana,sans-serif; outline:none; }
        .mail-copy-btn { width:100%; margin-top:10px; padding:12px; border:none; border-radius:9px; background:var(--text-main); color:var(--card-bg); font-weight:800; cursor:pointer; }
        .mail-outlook-btn { width:100%; margin-top:8px; padding:12px; border:none; border-radius:9px; background:#0A64AD; color:#fff; font-weight:800; cursor:pointer; }
        .mail-outlook-btn:hover { opacity:.92; }
        .mail-note { margin-top:8px; color:var(--text-muted); font-size:.7rem; line-height:1.4; text-align:center; }
        @media (max-width: 1180px) { .wrapper { flex-wrap:wrap; } .mail-panel { width:100%; max-width:580px; } }
    
        /* Sağ panel: açılır/kapanır mail ve ödeme bildirimi */
        .collapsible-mail{padding:0 18px 18px!important;}
        .collapsible-mail::before{display:none!important;}
        .mail-panel-toggle{width:calc(100% + 36px);margin:0 -18px;border:0;background:#0b1220;color:#fff;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;font-weight:900;font-size:.95rem;cursor:pointer;letter-spacing:.2px;}
        .mail-panel-toggle #mailPanelIcon{font-size:1.25rem;line-height:1;}
        .mail-panel-content{display:none;padding-top:14px;}
        .mail-panel-content.show{display:block;}
        .mail-section{border:1px solid #dfe5ec;border-radius:14px;overflow:hidden;background:#fff;margin-bottom:12px;}
        .mail-section-title{width:100%;border:0;background:#f6f8fb;color:#111827;padding:13px 14px;display:flex;justify-content:space-between;align-items:center;font-weight:900;cursor:pointer;text-align:left;}
        .mail-section-body{display:none;padding:14px;}
        .mail-section-body.show{display:block;}
        .short-preview{min-height:170px!important;}
        body[data-theme="light"] .mail-section{background:#fff!important;}
        body[data-theme="light"] .mail-section-title{background:#f6f8fb!important;color:#111827!important;}
        .top-actions{display:none!important;}



/* ===== V3: ORTALANMIŞ RENEW KİMLİĞİ + GELİŞMİŞ SAĞ ACCORDION ===== */
